{
  "name": "webarkit-studio",
  "version": "0.2.0",
  "private": true,
  "description": "WebARKit Studio: node-based WebAR authoring tool (Rete.js + JsartoolkitNFT)",
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webarkit/webarkit-studio.git"
  },
  "homepage": "https://github.com/webarkit/webarkit-studio#readme",
  "bugs": {
    "url": "https://github.com/webarkit/webarkit-studio/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:player",
    "build": "tsc --noEmit && npm run build:player && vite build",
    "build:player": "vite build -c vite.player.config.ts",
    "build:plugin-api": "node scripts/build-plugin-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/fetch-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "bench": "tsx tests/bench/run.ts",
    "check:agents": "node scripts/check-agent-docs.mjs",
    "trace:record": "node scripts/trace-record.mjs",
    "trace:diff": "node scripts/trace-diff.mjs",
    "mcp:setup": "node scripts/mcp-setup.mjs",
    "mcp:studio": "node --import tsx src/mcp/main.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "trackability": "node scripts/trackability.mjs",
    "example:marker": "node scripts/example-pipeline.mjs marker",
    "example:project": "node scripts/example-pipeline.mjs project"
  },
  "dependencies": {
    "@babylonjs/core": "9.30.0",
    "@babylonjs/loaders": "9.30.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@webarkit/camera-view": "^0.1.0",
    "@webarkit/jsartoolkit-nft": "^1.16.0",
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "lit": "^3.3.3",
    "rete": "^2.0.6",
    "rete-area-plugin": "^2.3.2",
    "rete-comment-plugin": "^2.2.0",
    "rete-connection-plugin": "^2.0.5",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-history-plugin": "^2.2.0",
    "rete-minimap-plugin": "^2.0.3",
    "rete-render-utils": "^2.0.3",
    "three": "^0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "tinybench": "^6.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "type": "module"
}
