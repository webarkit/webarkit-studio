{
 "format": "webarkit-studio/graph",
 "version": 6,
 "name": "Pinball NFT \u00b7 materials and a texture",
 "plugins": [
  {
   "id": "jsartoolkitNFT",
   "version": "0.1.0"
  }
 ],
 "nodes": [
  {
   "id": "camera",
   "type": "source.camera",
   "params": {
    "facingMode": "environment",
    "width": 640,
    "height": 480
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "id": "camparams",
   "type": "jsartoolkitNFT.cameraParams",
   "params": {
    "url": "data/camera_para.dat"
   },
   "position": {
    "x": 0,
    "y": 207
   }
  },
  {
   "id": "dataset",
   "type": "jsartoolkitNFT.dataset",
   "params": {
    "url": "data/DataNFT/pinball",
    "name": "pinball"
   },
   "position": {
    "x": 0,
    "y": 369
   }
  },
  {
   "id": "settings",
   "type": "jsartoolkitNFT.settings",
   "params": {
    "continuousDetection": true,
    "detectionInterval": 300,
    "logLevel": "2"
   },
   "position": {
    "x": 0,
    "y": 559
   }
  },
  {
   "id": "filter",
   "type": "filter.oneEuro",
   "params": {
    "minCutOff": 0.0001,
    "beta": 0.01,
    "warmUp": 5
   },
   "position": {
    "x": 0,
    "y": 1155
   }
  },
  {
   "id": "controller",
   "type": "jsartoolkitNFT.controller",
   "params": {
    "build": "simd"
   },
   "position": {
    "x": 320,
    "y": 0
   }
  },
  {
   "id": "renderer",
   "type": "three.renderer",
   "params": {
    "antialias": true
   },
   "position": {
    "x": 320,
    "y": 560
   }
  },
  {
   "id": "scene",
   "type": "scene.scene",
   "params": {
    "defaultLights": false
   },
   "position": {
    "x": 320,
    "y": 717
   }
  },
  {
   "id": "keylight",
   "type": "scene.light",
   "params": {
    "kind": "directional",
    "color": "#ffffff",
    "intensity": 2.5
   },
   "position": {
    "x": 640,
    "y": 823
   }
  },
  {
   "id": "filllight",
   "type": "scene.light",
   "params": {
    "kind": "ambient",
    "color": "#ffffff",
    "intensity": 0.6
   },
   "position": {
    "x": 640,
    "y": 1057
   }
  },
  {
   "id": "arcamera",
   "type": "scene.arCamera",
   "params": {},
   "position": {
    "x": 640,
    "y": 0
   }
  },
  {
   "id": "markers",
   "type": "debug.inspector",
   "params": {},
   "position": {
    "x": 640,
    "y": 124
   }
  },
  {
   "id": "stats",
   "type": "debug.stats",
   "params": {
    "overlay": true
   },
   "position": {
    "x": 640,
    "y": 284
   }
  },
  {
   "id": "view",
   "type": "output.arView",
   "params": {
    "stats": true
   },
   "position": {
    "x": 960,
    "y": 0
   }
  },
  {
   "id": "select_pinball",
   "type": "tracking.selectMarker",
   "params": {
    "marker": "pinball"
   },
   "position": {
    "x": 640,
    "y": 520
   }
  },
  {
   "id": "anchor_pinball",
   "type": "scene.anchor",
   "params": {
    "center": true
   },
   "position": {
    "x": 960,
    "y": 250
   }
  },
  {
   "id": "prim_pinball",
   "type": "scene.mesh",
   "params": {
    "color": "#ff0055",
    "spin": true,
    "scale": [
     1,
     1,
     1
    ],
    "rest": true,
    "position": [
     0,
     0,
     20
    ]
   },
   "position": {
    "x": 960,
    "y": 535
   }
  },
  {
   "id": "prim_pinball_geometry",
   "type": "geometry.torusKnot",
   "params": {
    "radius": 26.666666666666668,
    "tube": 8,
    "p": 2,
    "q": 3,
    "detail": 100
   },
   "position": {
    "x": 720,
    "y": 535
   }
  },
  {
   "id": "poster_texture",
   "type": "scene.texture",
   "params": {
    "url": "textures/tiles.png",
    "wrap": "repeat",
    "repeatU": 1,
    "repeatV": 1
   },
   "position": {
    "x": 480,
    "y": 960
   }
  },
  {
   "id": "poster_material",
   "type": "scene.material",
   "params": {
    "color": "#ffffff",
    "metalness": 0,
    "roughness": 0.8,
    "emissive": "#000000",
    "emissiveIntensity": 1,
    "opacity": 0.9,
    "side": "front",
    "unlit": false
   },
   "position": {
    "x": 720,
    "y": 960
   }
  },
  {
   "id": "poster_geometry",
   "type": "geometry.plane",
   "params": {
    "width": 120,
    "depth": 120
   },
   "position": {
    "x": 720,
    "y": 1180
   }
  },
  {
   "id": "poster",
   "type": "scene.mesh",
   "params": {
    "color": "#ffffff",
    "position": [
     0,
     0,
     1
    ],
    "rotation": [
     0,
     0,
     0
    ],
    "scale": [
     1,
     1,
     1
    ],
    "rest": false,
    "spin": false
   },
   "position": {
    "x": 960,
    "y": 960
   }
  },
  {
   "id": "chrome",
   "type": "scene.material",
   "params": {
    "color": "#d8dce0",
    "metalness": 1,
    "roughness": 0.25,
    "emissive": "#000000",
    "emissiveIntensity": 1,
    "opacity": 1,
    "side": "front",
    "unlit": false
   },
   "position": {
    "x": 720,
    "y": 760
   }
  }
 ],
 "edges": [
  {
   "id": "e1",
   "from": {
    "node": "camera",
    "port": "video"
   },
   "to": {
    "node": "controller",
    "port": "video"
   }
  },
  {
   "id": "e2",
   "from": {
    "node": "camparams",
    "port": "params"
   },
   "to": {
    "node": "controller",
    "port": "cameraParams"
   }
  },
  {
   "id": "e3",
   "from": {
    "node": "dataset",
    "port": "dataset"
   },
   "to": {
    "node": "controller",
    "port": "dataset"
   }
  },
  {
   "id": "e4",
   "from": {
    "node": "settings",
    "port": "settings"
   },
   "to": {
    "node": "controller",
    "port": "settings"
   }
  },
  {
   "id": "e5",
   "from": {
    "node": "filter",
    "port": "filter"
   },
   "to": {
    "node": "controller",
    "port": "filter"
   }
  },
  {
   "id": "e6",
   "from": {
    "node": "controller",
    "port": "projection"
   },
   "to": {
    "node": "arcamera",
    "port": "projection"
   }
  },
  {
   "id": "e7",
   "from": {
    "node": "controller",
    "port": "markers"
   },
   "to": {
    "node": "markers",
    "port": "value"
   }
  },
  {
   "id": "e8",
   "from": {
    "node": "controller",
    "port": "stats"
   },
   "to": {
    "node": "stats",
    "port": "stats"
   }
  },
  {
   "id": "e9",
   "from": {
    "node": "renderer",
    "port": "renderer"
   },
   "to": {
    "node": "scene",
    "port": "renderer"
   }
  },
  {
   "id": "e10",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "keylight",
    "port": "scene"
   }
  },
  {
   "id": "e11",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "filllight",
    "port": "scene"
   }
  },
  {
   "id": "e12",
   "from": {
    "node": "controller",
    "port": "markers"
   },
   "to": {
    "node": "select_pinball",
    "port": "markers"
   }
  },
  {
   "id": "e13",
   "from": {
    "node": "select_pinball",
    "port": "pose"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "pose"
   }
  },
  {
   "id": "e14",
   "from": {
    "node": "select_pinball",
    "port": "found"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "found"
   }
  },
  {
   "id": "e15",
   "from": {
    "node": "select_pinball",
    "port": "markerInfo"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "markerInfo"
   }
  },
  {
   "id": "e16",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "scene"
   }
  },
  {
   "id": "e17",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "prim_pinball",
    "port": "scene"
   }
  },
  {
   "id": "e18",
   "from": {
    "node": "prim_pinball",
    "port": "object"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "children"
   }
  },
  {
   "id": "e19",
   "from": {
    "node": "anchor_pinball",
    "port": "object"
   },
   "to": {
    "node": "view",
    "port": "objects"
   }
  },
  {
   "id": "e20",
   "from": {
    "node": "keylight",
    "port": "object"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "children"
   }
  },
  {
   "id": "e21",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "view",
    "port": "scene"
   }
  },
  {
   "id": "e22",
   "from": {
    "node": "arcamera",
    "port": "camera"
   },
   "to": {
    "node": "view",
    "port": "camera"
   }
  },
  {
   "id": "e23",
   "from": {
    "node": "camera",
    "port": "video"
   },
   "to": {
    "node": "view",
    "port": "video"
   }
  },
  {
   "id": "migrated_edge",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "prim_pinball_geometry",
    "port": "scene"
   }
  },
  {
   "id": "migrated_edge_2",
   "from": {
    "node": "prim_pinball_geometry",
    "port": "geometry"
   },
   "to": {
    "node": "prim_pinball",
    "port": "geometry"
   }
  },
  {
   "id": "m1",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "poster_texture",
    "port": "scene"
   }
  },
  {
   "id": "m2",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "poster_material",
    "port": "scene"
   }
  },
  {
   "id": "m3",
   "from": {
    "node": "poster_texture",
    "port": "texture"
   },
   "to": {
    "node": "poster_material",
    "port": "map"
   }
  },
  {
   "id": "m4",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "poster_geometry",
    "port": "scene"
   }
  },
  {
   "id": "m5",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "poster",
    "port": "scene"
   }
  },
  {
   "id": "m6",
   "from": {
    "node": "poster_geometry",
    "port": "geometry"
   },
   "to": {
    "node": "poster",
    "port": "geometry"
   }
  },
  {
   "id": "m7",
   "from": {
    "node": "poster_material",
    "port": "material"
   },
   "to": {
    "node": "poster",
    "port": "material"
   }
  },
  {
   "id": "m8",
   "from": {
    "node": "poster",
    "port": "object"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "children"
   }
  },
  {
   "id": "m9",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "chrome",
