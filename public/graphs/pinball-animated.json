{
 "format": "webarkit-studio/graph",
 "version": 5,
 "name": "Pinball · animated model, plays on found, pauses on lost",
 "plugins": [
  {
   "id": "jsartoolkitNFT",
   "version": "0.1.0"
  }
 ],
 "nodes": [
  {
   "id": "camera",
   "type": "source.camera",
   "params": {
    "facingMode": "environment",
    "width": 640,
    "height": 480
   },
   "position": {
    "x": 0,
    "y": 0
   }
  },
  {
   "id": "camparams",
   "type": "jsartoolkitNFT.cameraParams",
   "params": {
    "url": "data/camera_para.dat"
   },
   "position": {
    "x": 0,
    "y": 207
   }
  },
  {
   "id": "dataset",
   "type": "jsartoolkitNFT.dataset",
   "params": {
    "url": "data/DataNFT/pinball",
    "name": "pinball"
   },
   "position": {
    "x": 0,
    "y": 369
   }
  },
  {
   "id": "settings",
   "type": "jsartoolkitNFT.settings",
   "params": {
    "continuousDetection": true,
    "detectionInterval": 300,
    "logLevel": "2"
   },
   "position": {
    "x": 0,
    "y": 559
   }
  },
  {
   "id": "filter",
   "type": "filter.oneEuro",
   "params": {
    "minCutOff": 0.0001,
    "beta": 0.01,
    "warmUp": 5
   },
   "position": {
    "x": 0,
    "y": 1155
   }
  },
  {
   "id": "controller",
   "type": "jsartoolkitNFT.controller",
   "params": {
    "build": "simd"
   },
   "position": {
    "x": 320,
    "y": 0
   }
  },
  {
   "id": "renderer",
   "type": "three.renderer",
   "params": {
    "antialias": true
   },
   "position": {
    "x": 320,
    "y": 560
   }
  },
  {
   "id": "scene",
   "type": "scene.scene",
   "params": {
    "defaultLights": false
   },
   "position": {
    "x": 320,
    "y": 717
   }
  },
  {
   "id": "keylight",
   "type": "scene.light",
   "params": {
    "kind": "directional",
    "color": "#ffffff",
    "intensity": 2.5
   },
   "position": {
    "x": 640,
    "y": 823
   }
  },
  {
   "id": "filllight",
   "type": "scene.light",
   "params": {
    "kind": "ambient",
    "color": "#ffffff",
    "intensity": 0.6
   },
   "position": {
    "x": 640,
    "y": 1057
   }
  },
  {
   "id": "arcamera",
   "type": "scene.arCamera",
   "params": {},
   "position": {
    "x": 640,
    "y": 0
   }
  },
  {
   "id": "markers",
   "type": "debug.inspector",
   "params": {},
   "position": {
    "x": 640,
    "y": 124
   }
  },
  {
   "id": "stats",
   "type": "debug.stats",
   "params": {
    "overlay": true
   },
   "position": {
    "x": 640,
    "y": 284
   }
  },
  {
   "id": "view",
   "type": "output.arView",
   "params": {
    "stats": true
   },
   "position": {
    "x": 960,
    "y": 0
   }
  },
  {
   "id": "select_pinball",
   "type": "tracking.selectMarker",
   "params": {
    "marker": "pinball"
   },
   "position": {
    "x": 640,
    "y": 520
   }
  },
  {
   "id": "anchor_pinball",
   "type": "scene.anchor",
   "params": {
    "center": true
   },
   "position": {
    "x": 960,
    "y": 250
   }
  },
  {
   "id": "model",
   "type": "scene.gltf",
   "params": {
    "url": "models/cube-animated.glb",
    "scale": 80,
    "position": [
     0,
     0,
     0
    ],
    "rotation": [
     0,
     0,
     0
    ],
    "autoplay": false
   },
   "position": {
    "x": 960,
    "y": 535
   }
  },
  {
   "id": "play",
   "type": "action.playAnimation",
   "params": {
    "clip": "",
    "loop": true,
    "speed": 1
   },
   "position": {
    "x": 960,
    "y": 800
   }
  }
 ],
 "edges": [
  {
   "id": "e1",
   "from": {
    "node": "camera",
    "port": "video"
   },
   "to": {
    "node": "controller",
    "port": "video"
   }
  },
  {
   "id": "e2",
   "from": {
    "node": "camparams",
    "port": "params"
   },
   "to": {
    "node": "controller",
    "port": "cameraParams"
   }
  },
  {
   "id": "e3",
   "from": {
    "node": "dataset",
    "port": "dataset"
   },
   "to": {
    "node": "controller",
    "port": "dataset"
   }
  },
  {
   "id": "e4",
   "from": {
    "node": "settings",
    "port": "settings"
   },
   "to": {
    "node": "controller",
    "port": "settings"
   }
  },
  {
   "id": "e5",
   "from": {
    "node": "filter",
    "port": "filter"
   },
   "to": {
    "node": "controller",
    "port": "filter"
   }
  },
  {
   "id": "e6",
   "from": {
    "node": "controller",
    "port": "projection"
   },
   "to": {
    "node": "arcamera",
    "port": "projection"
   }
  },
  {
   "id": "e7",
   "from": {
    "node": "controller",
    "port": "markers"
   },
   "to": {
    "node": "markers",
    "port": "value"
   }
  },
  {
   "id": "e8",
   "from": {
    "node": "controller",
    "port": "stats"
   },
   "to": {
    "node": "stats",
    "port": "stats"
   }
  },
  {
   "id": "e9",
   "from": {
    "node": "renderer",
    "port": "renderer"
   },
   "to": {
    "node": "scene",
    "port": "renderer"
   }
  },
  {
   "id": "e10",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "keylight",
    "port": "scene"
   }
  },
  {
   "id": "e11",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "filllight",
    "port": "scene"
   }
  },
  {
   "id": "e12",
   "from": {
    "node": "controller",
    "port": "markers"
   },
   "to": {
    "node": "select_pinball",
    "port": "markers"
   }
  },
  {
   "id": "e13",
   "from": {
    "node": "select_pinball",
    "port": "pose"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "pose"
   }
  },
  {
   "id": "e14",
   "from": {
    "node": "select_pinball",
    "port": "found"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "found"
   }
  },
  {
   "id": "e15",
   "from": {
    "node": "select_pinball",
    "port": "markerInfo"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "markerInfo"
   }
  },
  {
   "id": "e16",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "scene"
   }
  },
  {
   "id": "e17",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "model",
    "port": "scene"
   }
  },
  {
   "id": "e18",
   "from": {
    "node": "model",
    "port": "object"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "children"
   }
  },
  {
   "id": "e19",
   "from": {
    "node": "anchor_pinball",
    "port": "object"
   },
   "to": {
    "node": "view",
    "port": "objects"
   }
  },
  {
   "id": "e20",
   "from": {
    "node": "keylight",
    "port": "object"
   },
   "to": {
    "node": "anchor_pinball",
    "port": "children"
   }
  },
  {
   "id": "e21",
   "from": {
    "node": "scene",
    "port": "scene"
   },
   "to": {
    "node": "view",
    "port": "scene"
   }
  },
  {
   "id": "e22",
   "from": {
    "node": "arcamera",
    "port": "camera"
   },
   "to": {
    "node": "view",
    "port": "camera"
   }
  },
  {
   "id": "e23",
   "from": {
    "node": "camera",
    "port": "video"
   },
   "to": {
    "node": "view",
    "port": "video"
   }
  },
  {
   "id": "play-target",
   "from": {
    "node": "model",
    "port": "object"
   },
   "to": {
    "node": "play",
    "port": "target"
   }
  },
  {
   "id": "play-found",
   "from": {
    "node": "select_pinball",
    "port": "onFound"
   },
   "to": {
    "node": "play",
    "port": "play"
   }
  },
  {
   "id": "play-lost",
   "from": {
    "node": "select_pinball",
    "port": "onLost"
   },
   "to": {
    "node": "play",
    "port": "pause"
   }
  }
 ]
}
