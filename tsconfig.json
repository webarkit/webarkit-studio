{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    // vite.config.ts and what it imports run in Node, whose loader needs file extensions.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "@webarkit/studio-plugin-api": ["./src/plugin-api/index.ts"] }
  },
  "include": ["src", "plugins", "tests", "webarkit-studio.config.ts", "vite.config.ts", "vite.player.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
